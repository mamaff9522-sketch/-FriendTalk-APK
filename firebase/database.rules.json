{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !root.child('bans').child(auth.uid).exists() && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider !== 'password')",
        ".validate": "newData.hasChildren(['displayName'])",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().beginsWith('https://'))"
        },
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "gender": {
          ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'male' || newData.val() === 'female' || newData.val() === 'other')"
        },
        "age": {
          ".validate": "newData.isNumber() && newData.val() >= 18 && newData.val() <= 99"
        },
        "province": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "interests": {
          "$i": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "lastActive": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$name": {
        ".write": "auth != null && !root.child('bans').child(auth.uid).exists() && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))"
      }
    },
    "roles": {
      ".read": "auth != null",
      ".write": false
    },
    "bans": {
      ".read": "auth != null",
      ".write": false
    },
    "wallets": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "coinTransactions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "posts": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt",
        "authorUid",
        "clubId"
      ],
      "$postId": {
        ".write": "auth != null && !root.child('bans').child(auth.uid).exists() && ((!data.exists() && newData.child('authorUid').val() === auth.uid) || (data.exists() && data.child('authorUid').val() === auth.uid))"
      }
    },
    "postLikes": {
      ".read": "auth != null",
      "$postId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !root.child('bans').child(auth.uid).exists()"
        }
      }
    },
    "postComments": {
      ".read": "auth != null",
      "$postId": {
        "$cid": {
          ".write": "auth != null && !root.child('bans').child(auth.uid).exists() && ((!data.exists() && newData.child('authorUid').val() === auth.uid) || (data.exists() && data.child('authorUid').val() === auth.uid))"
        }
      }
    },
    "userFeeds": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && root.child('chatMembers').child($chatId).child(auth.uid).exists()",
        "lastMessage": {
          ".write": "auth != null && !root.child('bans').child(auth.uid).exists() && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider !== 'password') && root.child('chatMembers').child($chatId).child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "lastAt": {
          ".write": "auth != null && !root.child('bans').child(auth.uid).exists() && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider !== 'password') && root.child('chatMembers').child($chatId).child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "lastSenderUid": {
          ".write": "auth != null && !root.child('bans').child(auth.uid).exists() && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider !== 'password') && root.child('chatMembers').child($chatId).child(auth.uid).exists()",
          ".validate": "newData.val() === auth.uid"
        }
      }
    },
    "chatMembers": {
      "$chatId": {
        ".read": "auth != null && data.child(auth.uid).exists()",
        ".write": false
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chatMembers').child($chatId).child(auth.uid).exists()",
        "$msgId": {
          ".write": "auth != null && !data.exists() && !root.child('bans').child(auth.uid).exists() && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider !== 'password') && root.child('chatMembers').child($chatId).child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['senderUid','at']) && (newData.hasChild('text') || newData.hasChild('imagePath'))",
          "senderUid": {
            ".validate": "newData.val() === auth.uid"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000"
          },
          "imagePath": {
            ".validate": "newData.isString() && newData.val().beginsWith('chatImages/' + $chatId + '/' + auth.uid + '/') && newData.val().length <= 300"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 600000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "lives": {
      ".read": "auth != null",
      ".write": false
    },
    "liveViewers": {
      ".read": "auth != null",
      "$liveId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !root.child('bans').child(auth.uid).exists()"
        }
      }
    },
    "liveComments": {
      ".read": "auth != null",
      "$liveId": {
        "$cid": {
          ".write": "auth != null && !data.exists() && !root.child('bans').child(auth.uid).exists() && newData.child('authorUid').val() === auth.uid"
        }
      }
    },
    "liveGifts": {
      ".read": "auth != null",
      ".write": false
    },
    "clubs": {
      ".read": "auth != null",
      ".write": false
    },
    "clubMembers": {
      ".read": "auth != null",
      ".write": false
    },
    "userClubs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "gifts": {
      ".read": "auth != null",
      ".write": false
    },
    "coinPackages": {
      ".read": "auth != null",
      ".write": false
    },
    "appConfig": {
      ".read": "auth != null",
      ".write": false
    },
    "reports": {
      "$rid": {
        ".write": "auth != null && !data.exists() && !root.child('bans').child(auth.uid).exists() && newData.child('reporterUid').val() === auth.uid"
      }
    },
    "aiBots": {
      ".read": "auth != null",
      ".write": false
    },
    "botChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "uiLayouts": {
      "$screen": {
        "current": {
          ".read": "auth != null"
        },
        ".write": false
      }
    },
    "readReceipts": {
      "$chatId": {
        ".read": "auth != null && root.child('chatMembers').child($chatId).child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('chatMembers').child($chatId).child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        }
      }
    },
    "matches": {
      "$pairId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": false
      }
    },
    "matchNotifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$pairId": {
          "seen": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "swipes": {
      ".read": false,
      ".write": false
    }
  }
}